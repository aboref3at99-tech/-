OPENAI_API_KEY=sk-...

# Optional model
OPENAI_MODEL=gpt-5.2

# timeout in seconds for a single /run request
RUN_TIMEOUT_SECONDS=180

# CORS origins for production frontend(s). comma-separated, use * only for dev
CORS_ORIGINS=*

# Internal MCP URLs
PLAYWRIGHT_MCP_URL=http://playwright:8931/mcp
MYTOOLS_MCP_URL=http://mytools:8000/mcp

# File-backed storage for video projects (MVP)
VIDEO_PROJECTS_FILE=/tmp/ai-agent-mcp/video-projects.json

# Optional: if you want mytools to proxy an internal API
MY_AI_TOOLS_BASE_URL=http://host.docker.internal:9000
MY_AI_TOOLS_TOKEN=

# Basic in-memory rate limit
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
